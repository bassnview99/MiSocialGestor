<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>NubeDroid</title>
<script src="./vendor/react.js"></script>
<script src="./vendor/react-dom.js"></script>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&amp;display=swap">
<style>
body{margin:0;font-family:'Montserrat',system-ui,sans-serif;background:#F7FAFD;color:#32425C}
a{color:#1559B8}a:hover{color:#0B2A5B}
button{font-family:inherit;cursor:pointer}
.cta:hover{filter:brightness(1.08)}
.card{box-shadow:0 1px 2px rgba(11,42,91,.06),0 8px 24px rgba(11,42,91,.06)}
</style>
</helmet>
<div style="width:100%;min-height:100vh;box-sizing:border-box;background:#F7FAFD;color:#32425C;font-family:'Montserrat',system-ui,sans-serif;display:flex;flex-direction:column">

<!-- Top bar -->
<div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:20px 32px;max-width:1120px;width:100%;box-sizing:border-box;margin:0 auto">
<div style="font-weight:800;font-size:18px;letter-spacing:.02em;color:#0B2A5B">NUBE<span style="font-weight:500">DROID</span></div>
<div style="display:flex;gap:6px;padding:4px;border-radius:999px;background:#E3EDF8" role="group" aria-label="Idioma / Language">
<button type="button" onClick="{{setEs}}" aria-pressed="{{isEs}}" style="{{esStyle}}">Español</button>
<button type="button" onClick="{{setEn}}" aria-pressed="{{isEn}}" style="{{enStyle}}">English</button>
</div>
</div>

<!-- Hero -->
<div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;padding:24px 24px 72px;max-width:860px;width:100%;box-sizing:border-box;margin:0 auto">
<img src="./assets/7395bf328df2b4d1c9b64dc075709a1d.jpg" alt="NubeDroid — Acceso Remoto para Android" style="width:100%;max-width:520px;height:auto;mix-blend-mode:multiply">
<div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:999px;background:#E3EDF8;color:#0B2A5B;font-size:13px;font-weight:700;letter-spacing:.04em;text-transform:uppercase">{{t.badge}}</div>
<h1 style="margin:0;font-size:44px;line-height:1.12;font-weight:800;color:#0B2A5B;letter-spacing:-.01em">{{t.h1}}</h1>
<p style="margin:0;font-size:19px;line-height:1.6;color:#32425C;max-width:680px">{{t.lead}}</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:8px">
<a class="cta" href="https://wa.me/56930086081" style="display:inline-flex;align-items:center;min-height:48px;padding:0 26px;border-radius:12px;background:#1559B8;color:#FFFFFF;font-weight:700;font-size:16px;text-decoration:none">{{t.ctaWa}}</a>
<a class="cta" href="#contacto" style="display:inline-flex;align-items:center;min-height:48px;padding:0 26px;border-radius:12px;background:#FFFFFF;color:#0B2A5B;font-weight:700;font-size:16px;text-decoration:none;border:2px solid #C9DAEE">{{t.ctaMore}}</a>
</div>
</div>

<!-- How it works -->
<div style="background:#FFFFFF;padding:72px 24px">
<div style="max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:36px">
<div style="display:flex;flex-direction:column;gap:10px">
<h2 style="margin:0;font-size:32px;font-weight:800;color:#0B2A5B">{{t.howTitle}}</h2>
<p style="margin:0;font-size:17px;line-height:1.6;max-width:640px">{{t.howSub}}</p>
</div>
<div style="display:flex;flex-wrap:wrap;gap:20px">
<sc-for list="{{steps}}" as="s" hint-placeholder-count="4">
<div class="card" style="flex:1 1 240px;min-width:0;box-sizing:border-box;padding:24px;border-radius:16px;background:#F7FAFD;border:1px solid #E1EAF5;display:flex;flex-direction:column;gap:12px">
<div style="width:40px;height:40px;border-radius:50%;background:#0B2A5B;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px">{{s.n}}</div>
<div style="font-weight:700;font-size:18px;color:#0B2A5B">{{s.title}}</div>
<div style="font-size:15px;line-height:1.55">{{s.text}}</div>
</div>
</sc-for>
</div>
</div>
</div>

<!-- Features -->
<div style="padding:72px 24px">
<div style="max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:36px">
<h2 style="margin:0;font-size:32px;font-weight:800;color:#0B2A5B">{{t.featTitle}}</h2>
<div style="display:flex;flex-wrap:wrap;gap:16px">
<sc-for list="{{feats}}" as="f" hint-placeholder-count="6">
<div style="flex:1 1 320px;min-width:0;box-sizing:border-box;display:flex;gap:14px;align-items:flex-start;padding:18px 20px;border-radius:14px;background:#FFFFFF;border:1px solid #E1EAF5">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1559B8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:2px"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
<div style="font-size:15px;line-height:1.55">{{f}}</div>
</div>
</sc-for>
</div>
</div>
</div>

<!-- Status -->
<div style="padding:0 24px 72px">
<div style="max-width:1120px;margin:0 auto;box-sizing:border-box;padding:36px;border-radius:20px;background:#0B2A5B;color:#E9F1FB;display:flex;flex-direction:column;gap:16px">
<h2 style="margin:0;font-size:28px;font-weight:800;color:#FFFFFF">{{t.statusTitle}}</h2>
<p style="margin:0;font-size:16px;line-height:1.65;max-width:820px">{{t.status1}}</p>
<p style="margin:0;font-size:16px;line-height:1.65;max-width:820px">{{t.status2}}</p>
<p style="margin:0;font-size:16px;line-height:1.65;max-width:820px">{{t.status3}}</p>
</div>
</div>

<!-- Feedback -->
<div style="background:#FFFFFF;padding:72px 24px">
<div style="max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:36px">
<div style="display:flex;flex-direction:column;gap:10px">
<h2 style="margin:0;font-size:32px;font-weight:800;color:#0B2A5B">{{t.askTitle}}</h2>
<p style="margin:0;font-size:17px;line-height:1.6;max-width:640px">{{t.askSub}}</p>
</div>
<div style="display:flex;flex-wrap:wrap;gap:20px">
<sc-for list="{{questions}}" as="q" hint-placeholder-count="3">
<div class="card" style="flex:1 1 300px;min-width:0;box-sizing:border-box;padding:24px;border-radius:16px;background:#F7FAFD;border:1px solid #E1EAF5;display:flex;flex-direction:column;gap:10px">
<div style="font-weight:800;font-size:28px;color:#1559B8">{{q.n}}</div>
<div style="font-size:16px;line-height:1.55;color:#0B2A5B;font-weight:600">{{q.text}}</div>
</div>
</sc-for>
</div>
</div>
</div>

<!-- Contact -->
<div id="contacto" style="padding:72px 24px">
<div style="max-width:860px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
<h2 style="margin:0;font-size:32px;font-weight:800;color:#0B2A5B">{{t.contactTitle}}</h2>
<p style="margin:0;font-size:17px;line-height:1.6;max-width:600px">{{t.contactSub}}</p>
<div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;width:100%">
<a class="card" href="https://wa.me/56930086081" style="flex:1 1 240px;min-width:0;box-sizing:border-box;padding:22px;border-radius:16px;background:#FFFFFF;border:1px solid #E1EAF5;text-decoration:none;display:flex;flex-direction:column;gap:6px">
<span style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#4A5B75">WhatsApp</span>
<span style="font-size:18px;font-weight:700;color:#0B2A5B">+56 9 3008 6081</span>
</a>
<a class="card" href="mailto:cbastias99@gmail.com" style="flex:1 1 240px;min-width:0;box-sizing:border-box;padding:22px;border-radius:16px;background:#FFFFFF;border:1px solid #E1EAF5;text-decoration:none;display:flex;flex-direction:column;gap:6px">
<span style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#4A5B75">Email</span>
<span style="font-size:18px;font-weight:700;color:#0B2A5B;overflow-wrap:anywhere">cbastias99@gmail.com</span>
</a>
<a class="card" href="https://instagram.com/migestorsocial" style="flex:1 1 240px;min-width:0;box-sizing:border-box;padding:22px;border-radius:16px;background:#FFFFFF;border:1px solid #E1EAF5;text-decoration:none;display:flex;flex-direction:column;gap:6px">
<span style="font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#4A5B75">Instagram</span>
<span style="font-size:18px;font-weight:700;color:#0B2A5B">@migestorsocial</span>
</a>
</div>
<p style="margin:8px 0 0;font-size:15px;line-height:1.6;color:#4A5B75;max-width:560px">{{t.closing}}</p>
</div>
</div>

<!-- Footer -->
<div style="padding:28px 24px;text-align:center;font-size:13px;color:#4A5B75;border-top:1px solid #E1EAF5;background:#FFFFFF">{{t.footer}}</div>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1280,"height":2600}}'>
class Component extends DCLogic {
renderVals() {
const lang = (this.state && this.state.lang) || 'es';
const es = lang === 'es';
const on = 'min-height:40px;padding:0 18px;border:0;border-radius:999px;background:#0B2A5B;color:#FFFFFF;font-weight:700;font-size:14px';
const off = 'min-height:40px;padding:0 18px;border:0;border-radius:999px;background:transparent;color:#0B2A5B;font-weight:600;font-size:14px';

const ES = {
badge: 'Prototipo temprano',
h1: 'Acceso remoto a un celular Android real, por tiempo limitado',
lead: 'Quería una forma simple de dar acceso a un teléfono Android físico por una sesión corta, sin pedir que instalen nada y sin exponer ADB directamente a internet.',
ctaWa: 'Quiero participar',
ctaMore: 'Ver contacto',
howTitle: 'Cómo funciona',
howSub: 'Un teléfono Android conectado a un PC, un enlace con vencimiento y un navegador. Eso es todo.',
steps: [
{ n: '1', title: 'Conecta el teléfono', text: 'Un Android conectado por USB/ADB a un PC con Windows.' },
{ n: '2', title: 'Crea una invitación', text: 'Desde la página de administración generas un enlace con tiempo: de 1 a 240 minutos.' },
{ n: '3', title: 'Comparte el enlace', text: 'El primer navegador que abra la invitación reclama la sesión y puede ver y controlar el teléfono.' },
{ n: '4', title: 'La sesión termina sola', text: 'Cuando vence el tiempo, el servidor cierra el stream.' }
],
featTitle: 'Qué incluye el prototipo',
feats: [
'Una página en el navegador para ver y controlar el teléfono. Quien recibe el enlace no instala nada.',
'Una página de administración que crea invitaciones con temporizador de 1 a 240 minutos.',
'Cloudflare Tunnel (Quick Tunnel) entrega una URL temporal trycloudflare.com: no hay que abrir puertos en el router.',
'ADB no queda expuesto directamente a internet.',
'En la versión web están desactivados el shell de ADB, el explorador de archivos y las devtools.',
'El primer navegador que abre la invitación reclama la sesión.'
],
statusTitle: 'Dónde estamos',
status1: 'Es un prototipo para Windows. Lo que sigo resolviendo es lograr un streaming confiable de punta a punta en la configuración Android/ADB objetivo: he tenido problemas con el arranque de ADB y conflictos de puerto de scrcpy.',
status2: 'Todavía no hay una demo pública para compartir.',
status3: 'La invitación es un enlace tipo bearer: quien lo abra primero reclama la sesión. No lo considero listo para producción mientras se validan el streaming y el modelo de seguridad.',
askTitle: 'Tu opinión me sirve',
askSub: 'Tres preguntas de diseño en las que me gustaría feedback.',
questions: [
{ n: '1', text: '¿Esperarías que la invitación quede atada al primer navegador, o debería poder reconectarse desde otro?' },
{ n: '2', text: '¿Qué salvaguardas querrías antes de confiar en una sesión de control remoto como esta?' },
{ n: '3', text: '¿Existe un enfoque más confiable para transmitir y controlar desde un navegador un Android conectado por USB?' }
],
contactTitle: '¿Quieres participar? Escríbeme',
contactSub: 'Cuéntame tu idea, tus dudas o tu experiencia con scrcpy, ADB y control remoto.',
closing: 'Si te suena útil, puedo compartir una demo corta cuando el stream del teléfono esté estable.',
footer: 'NubeDroid · Acceso Remoto para Android · Prototipo en desarrollo'
};

const EN = {
badge: 'Early prototype',
h1: 'Remote access to a real Android phone, for a limited time',
lead: 'I wanted a simple way to lend someone access to a physical Android phone for a short session, without asking them to install anything and without exposing ADB directly to the internet.',
ctaWa: 'I want to take part',
ctaMore: 'See contact',
howTitle: 'How it works',
howSub: 'An Android phone plugged into a PC, an expiring link and a browser. That is all.',
steps: [
{ n: '1', title: 'Plug in the phone', text: 'An Android phone connected over USB/ADB to a Windows PC.' },
{ n: '2', title: 'Create an invite', text: 'From the admin page you generate a timed link: anywhere from 1 to 240 minutes.' },
{ n: '3', title: 'Share the link', text: 'The first browser to open the invite claims the session and can view and control the phone.' },
{ n: '4', title: 'The session ends by itself', text: 'When the timer expires, the server closes the stream.' }
],
featTitle: 'What the prototype includes',
feats: [
'A browser page to view and control the phone. Whoever gets the link installs nothing.',
'An admin page that creates invites with a timer from 1 to 240 minutes.',
'Cloudflare Tunnel (Quick Tunnel) gives a temporary trycloudflare.com URL, so there is no router port forwarding.',
'ADB is not exposed directly to the internet.',
'ADB shell, file browsing and devtools are disabled in the web build.',
'The first browser to open the invite claims the session.'
],
statusTitle: 'Where we are',
status1: 'This is a Windows prototype. The part I am still working through is reliable end-to-end streaming on the target Android/ADB setup: I have hit ADB startup and scrcpy port-conflict issues.',
status2: 'There is no public live demo to share yet.',
status3: 'The invite is a bearer link, so anyone who opens it first can claim the session. I am not treating this as production-ready while the streaming and security model are still being validated.',
askTitle: 'I would value your feedback',
askSub: 'Three design questions where I would especially appreciate your thoughts.',
questions: [
{ n: '1', text: 'Would you expect the invite to be bound to the first browser, or should reconnecting from another browser be possible?' },
{ n: '2', text: 'What safeguards would you want before trusting a remote-control session like this?' },
{ n: '3', text: 'Is there a more reliable approach for streaming and controlling a USB-connected Android device from a browser?' }
],
contactTitle: 'Want to take part? Get in touch',
contactSub: 'Share your ideas, your questions, or your experience with scrcpy, ADB and remote control.',
closing: 'If this sounds useful, I can share a short demo once the phone stream is stable.',
footer: 'NubeDroid · Remote Access for Android · Prototype in development'
};

const t = es ? ES : EN;
return {
t: t,
steps: t.steps,
feats: t.feats,
questions: t.questions,
isEs: es,
isEn: !es,
esStyle: es ? on : off,
enStyle: es ? off : on,
setEs: () => this.setState({ lang: 'es' }),
setEn: () => this.setState({ lang: 'en' })
};
}
}
</script>
</body>
</html>
